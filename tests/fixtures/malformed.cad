$HEADER
GENCAD 1.4
DRAWING malformed
$ENDHEADER

$COMPONENTS
COMPONENT DUP1
PLACE 0.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE MISSING_SHAPE 0 0
DEVICE NO_DEVICE_RECORD
COMPONENT DUP1
PLACE 1.000 1.000
LAYER TOP
ROTATION 0.00
SHAPE TWO_PIN 0 0
DEVICE PWRCONN2P
PLACE 0.000
COMPONENT NOPE
PLACE 2.000
LAYER TOP
ROTATION banana
SHAPE TWO_PIN 0 0
DEVICE PWRCONN2P
$ENDCOMPONENTS

$SIGNALS
SIGNAL GOOD_NET
NODE DUP1 1
NODE GHOST 7
SIGNAL BAD_NET
NODE ONLYONE
SIGNAL NO_NAME
NODE DUP1 2
$ENDSIGNALS

$SHAPES
SHAPE TWO_PIN
PIN 1  PS_1 -50.000 0.000 TOP 0.00 0
PIN 2  PS_1 50.000 0.000 TOP 0.00 0
PIN 2  PS_1 60.000 0.000 TOP 0.00 0
PIN 3  PS_1 nope nope TOP 0.00 0
$ENDSHAPES

$ROUTES
ROUTE GOOD_NET
VIA PS_1 nope 0
VIA
ROUTE
$ENDROUTES

$WATSECTION
WAT 1 2 3
$ENDWATSECTION
