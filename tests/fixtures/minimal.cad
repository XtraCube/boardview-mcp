$HEADER
GENCAD 1.4
USER "boardview-mcp test fixture"
DRAWING fixture
REVISION "synthetic"
UNITS USER 1000
ORIGIN 0 0
INTERTRACK 0
ATTRIBUTE HEADER_1 "Number of Routing Layers" "1"
$ENDHEADER

$BOARD
ARTWORK artwork1 TOP
LINE 0.000 0.000 1000.000 0.000
LINE 1000.000 0.000 1000.000 500.000
LINE 1000.000 500.000 0.000 500.000
LINE 0.000 500.000 0.000 0.000
$ENDBOARD

$PADS
PAD P1 ROUND -1
CIRCLE 0.000 0.000 10.000
PAD P2 RECTANGULAR -1
RECTANGLE -5.000 -5.000 10.000 10.000
$ENDPADS

$PADSTACKS
PADSTACK PS_1 10.000
PAD P1 TOP 0.00 0
PADSTACK PS_2 5.000
PAD P2 BOTTOM 0.00 0
$ENDPADSTACKS

$SHAPES
SHAPE TWO_PIN
PIN 1  PS_1 -50.000 0.000 TOP 0.00 0
PIN 2  PS_2 50.000 0.000 TOP 0.00 0
SHAPE FOUR_PIN
PIN 1  PS_1 -75.000 0.000 TOP 0.00 0
PIN 2  PS_1 -25.000 0.000 TOP 0.00 0
PIN 3  PS_2 25.000 0.000 TOP 0.00 0
PIN 4  PS_2 75.000 0.000 TOP 0.00 0
SHAPE SIX_PIN_IC
PIN 1  PS_1 -100.000 50.000 TOP 0.00 0
PIN 2  PS_1 -60.000 50.000 TOP 0.00 0
PIN 3  PS_1 -20.000 50.000 TOP 0.00 0
PIN 4  PS_2 20.000 50.000 TOP 0.00 0
PIN 5  PS_2 60.000 50.000 TOP 0.00 0
PIN 6  PS_2 100.000 50.000 TOP 0.00 0
SHAPE ALPHAMIX
PIN A1  PS_1 0.000 0.000 TOP 0.00 0
PIN B2  PS_2 10.000 0.000 TOP 0.00 0
PIN MEC1  PS_1 0.000 20.000 TOP 0.00 0
$ENDSHAPES

$COMPONENTS
COMPONENT J1
PLACE 0.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE TWO_PIN 0 0
DEVICE PWRCONN2P
COMPONENT C1
PLACE 100.000 0.000
LAYER TOP
ROTATION 90.00
SHAPE TWO_PIN 0 0
DEVICE 10uF
COMPONENT R1
PLACE 200.000 0.000
LAYER BOTTOM
ROTATION 270.00
SHAPE TWO_PIN 0 0
DEVICE 100ohm
COMPONENT RS1
PLACE 300.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE FOUR_PIN 0 0
DEVICE 0.005ohm
COMPONENT IC1
PLACE 400.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE SIX_PIN_IC 0 0
DEVICE U_SOME_IC
COMPONENT K1
PLACE 500.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE TWO_PIN 0 0
DEVICE 1uH
COMPONENT FP1
PLACE 600.000 0.000
LAYER TOP
ROTATION 0.00
SHAPE ALPHAMIX 0 0
DEVICE MOUNTING_HOLE
$ENDCOMPONENTS

$DEVICES
DEVICE PWRCONN2P
PART PWRCONN2P
DEVICE 10uF
TOL 20
PART 10uF
DEVICE 100ohm
TOL 10
PART 100ohm
DEVICE 0.005ohm
TOL 10
PART 0.005ohm
DEVICE U_SOME_IC
PART U_SOME_IC
DEVICE 1uH
PART 1uH
DEVICE MOUNTING_HOLE
PART MOUNTING_HOLE
$ENDDEVICES

$SIGNALS
SIGNAL RAIL_IN
NODE J1 1
NODE C1 1
NODE R1 2
NODE IC1 6
SIGNAL MID_NET
NODE C1 2
NODE RS1 4
NODE K1 1
SIGNAL SENSE_A
NODE RS1 2
NODE IC1 1
SIGNAL ORPHAN_NET
SIGNAL ALPHA_NET
NODE FP1 A1
NODE FP1 MEC1
NODE IC1 B2
SIGNAL DUP_NET
NODE C1 1
NODE R1 1
NODE C1 1
$ENDSIGNALS

$TRACKS
TRACK 1 10.000
$ENDTRACKS

$LAYERS
DEFINE SOLDERMASK_TOP SOLDERMASK
$ENDLAYERS

$ROUTES
ROUTE RAIL_IN
VIA PS_1 0.000 0.000 ALL -2 via1
ROUTE MID_NET
ROUTE SENSE_A
ROUTE ALPHA_NET
ROUTE DUP_NET
$ENDROUTES
